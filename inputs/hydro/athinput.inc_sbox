<comment>
problem   = Stratified 3D MRI with zero-net vertical flux
reference = Stone, Hawley, Gammie, & Balbus
configure = --prob=strat -b --eos=isothermal

<job>
problem_id  = turb      # problem ID: basename of output filenames

<output1>
file_type   = hdf5             # HDF5 data dump
variable    = prim             # variables to be output
dt          = 0.314            # time increment between outputs

<output2>
file_type   = rst              # Restart dump
dt          = 3.14             # time increment between outputs

<output3>
file_type   = hst              # History data dump
dt          = 0.0001           # time increment between outputs

<time>
cfl_number  = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim        = -1         # cycle limit
tlim        = 314      # time limit (300 orbits)
integrator  = vl2       # time integration algorithm
xorder      = 2         # order of spatial reconstruction
ncycle_out  = 1         # interval for stdout summary info

<mesh>
nx1         = 128         # Number of zones in X1-direction
x1min       = -0.01        # minimum value of X1
x1max       = +0.01         # maximum value of X1
ix1_bc      = shear_periodic      # inner-X1 boundary flag
ox1_bc      = shear_periodic      # outer-X1 boundary flag

nx2         = 128        # Number of zones in X2-direction
x2min       = -0.01      # minimum value of X2
x2max       = +0.01      # maximum value of X2
ix2_bc      = periodic  # inner-X2 boundary flag
ox2_bc      = periodic  # outer-X2 boundary flag

nx3         = 128        # Number of zones in X3-direction
x3min       = -0.02      # minimum value of X3
x3max       = +0.02       # maximum value of X3
ix3_bc      = periodic      # inner-X3 boundary flag
ox3_bc      = periodic      # outer-X3 boundary flag

num_threads = 1         # maximum number of OMP threads

refinement        = none
numlevel          = 1
derefine_count    = 5

<meshblock>
nx1 = 16
nx2 = 16 
nx3 = 16 

<hydro>
iso_sound_speed = 0.005   # isothermal sound speed
dfloor          = 1.e-6
pfloor          = 1e-12

<orbital_advection>
OAorder      = 0     # 0: w/o OA, 1: w/ OA (1st), 2: w/ OA (2nd)
qshear       = 1.5     # shear rate
Omega0       = 1.0     # angular velocity of the system

<problem>
strat        = 1        # Switch on stratification

inc_turb     = 23        # drive turbulence (0) = off (1) = source (2) = loop
turbamp      = 0.005     # Set the turbulent amplitude factor
mxmin        = 2         
mxmax        = 4         
mymin        = 2
mymax        = 4        
mzmin        = 2
mzmax        = 4         
Nmodes       = 10        # The number of modes to have active
expo         = 2.0       # spherical k-shell power law
tcor         = 0.01      # The characteristic mode lifetime (should be suitably longer than the timestep)
solenoidal   = 0.5

